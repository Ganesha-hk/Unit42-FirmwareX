# Host-installed Nginx example. Replace hostname and certificate paths.
# Keep the upstream API bound to host loopback in compose.yaml.
server {
    listen 80;
    server_name firmware.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name firmware.example.com;
    ssl_certificate /etc/ssl/firmware/fullchain.pem;
    ssl_certificate_key /etc/ssl/firmware/privkey.pem;
    client_max_body_size 129m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This example assumes Nginx is the only public edge proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 240s;
    }
}
